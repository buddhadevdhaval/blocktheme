{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ambrygen/link-list",
  "version": "0.1.0",
  "title": "Link List",
  "category": "ambrygen",
  "description": "A list of resource downloads with a side heading.",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "links": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          }
        }
      }
    },
    "headingTag": {
      "type": "string",
      "enum": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ],
      "default": "h2"
    },
    "blockId": {
      "type": "string"
    }
  },
  "supports": {
    "html": false,
    "anchor": true
  },
  "example": {
    "attributes": {
      "blockId": "example-block-preview"
    }
  },
  "textdomain": "ambrygen-web",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}