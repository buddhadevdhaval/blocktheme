{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ambrygen/link-list",
  "version": "0.1.0",
  "title": "Link List",
  "category": "ambrygen",
  "description": "A list of resource downloads with a side heading.",
  "attributes": {
    "variation": {
      "type": "string",
      "enum": [
        "split-view",
        "grid-view"
      ],
      "default": "split-view"
    },
    "selectAllCollaborators": {
      "type": "boolean",
      "default": true
    },
    "collaboratorIds": {
      "type": "array",
      "default": [],
      "items": {
        "type": "number"
      }
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "headingTag": {
      "type": "string",
      "default": "h2"
    },
    "blockId": {
      "type": "string"
    }
  },
  "supports": {
    "html": false,
    "anchor": true
  },
  "variations": [
    {
      "name": "split-view",
      "title": "Split View",
      "description": "Currently have as it is.",
      "attributes": {
        "variation": "split-view"
      },
      "scope": [
        "inserter"
      ]
    },
    {
      "name": "grid-view",
      "title": "Grid View",
      "description": "Load all collaborator taxonomy terms and link each item to its term archive.",
      "attributes": {
        "variation": "grid-view"
      },
      "scope": [
        "inserter"
      ]
    }
  ],
  "textdomain": "ambrygen-web",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}