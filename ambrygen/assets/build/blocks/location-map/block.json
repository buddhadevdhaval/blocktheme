{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ambrygen/location-map",
  "title": "Location Map",
  "textdomain": "ambrygen-web",
  "category": "ambrygen",
  "icon": "location-alt",
  "description": "Block with Google Maps and location list",
  "supports": {
    "html": false
  },
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "iframe": {
      "type": "string",
      "default": ""
    },
    "locations": {
      "type": "array",
      "default": [
        {
          "id": "",
          "name": "",
          "address": ""
        },
        {
          "id": "",
          "name": "",
          "address": ""
        }
      ],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      }
    },
    "headingLevel": {
      "type": "string",
      "enum": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ],
      "default": "h2"
    }
  },
  "render": "file:./render.php",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "example": {
    "attributes": {
      "title": "Our Locations",
      "iframe": "https://www.google.com/maps/embed?pb=example",
      "locations": [
        {
          "id": "loc-headquarters",
          "name": "Headquarters",
          "address": "1 Enterprise, Aliso Viejo, CA 92656"
        },
        {
          "id": "loc-lab",
          "name": "Lab (For specimen shipments)",
          "address": "7 Argonaut, Aliso Viejo, CA 92656"
        }
      ],
      "headingLevel": "h2"
    }
  }
}