{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ambrygen/multimedia-assets",
  "title": "Multimedia Assets",
  "category": "ambrygen",
  "icon": "screenoptions",
  "description": "A layout displaying multimedia assets with downloads.",
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true
    }
  },
  "keywords": [
    "cards",
    "multimedia",
    "layout",
    "grid"
  ],
  "attributes": {
    "heading": {
      "type": "string",
      "default": ""
    },
    "headingTag": {
      "type": "string",
      "enum": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ],
      "default": "h2"
    },
    "blockId": {
      "type": "string"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "textdomain": "ambrygen-web",
  "example": {
    "attributes": {
      "blockId": "example-block-preview"
    }
  }
}