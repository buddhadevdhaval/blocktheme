{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ambrygen/multimedia-logo",
  "title": "Multimedia Logo",
  "category": "ambrygen",
  "icon": "format-image",
  "description": "Logo section with grouped downloads and supporting media.",
  "supports": {
    "html": false,
    "anchor": true
  },
  "attributes": {
    "sectionTitle": {
      "type": "string",
      "default": ""
    },
    "headingTag": {
      "type": "string",
      "enum": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ],
      "default": "h2"
    },
    "blockId": {
      "type": "string"
    },
    "logoImageUrl": {
      "type": "string",
      "default": ""
    },
    "logoImageId": {
      "type": "number",
      "default": 0
    },
    "logoImageAlt": {
      "type": "string",
      "default": ""
    },
    "downloads": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "groupName": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "fileUrl": {
            "type": "string"
          },
          "fileId": {
            "type": "number"
          }
        }
      }
    },
    "secondaryImageUrl": {
      "type": "string",
      "default": ""
    },
    "secondaryImageId": {
      "type": "number",
      "default": 0
    },
    "secondaryImageAlt": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "ambrygen-web",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "example": {
    "attributes": {
      "blockId": "example-block-preview"
    }
  }
}