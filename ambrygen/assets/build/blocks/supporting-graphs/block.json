{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ambrygen/supporting-graphs",
  "title": "Supporting Graphs",
  "category": "ambrygen",
  "icon": "chart-bar",
  "description": "Displays a supporting chart image with heading and description.",
  "textdomain": "ambrygen-web",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "headingTag": {
      "type": "string",
      "enum": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ],
      "default": "h2"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "number",
      "default": 0
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "variation": {
      "type": "string",
      "enum": [
        "default",
        "variation-style-steps"
      ],
      "default": "default"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "iconId": {
            "type": "number"
          },
          "iconUrl": {
            "type": "string"
          },
          "iconAlt": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "turnaroundLabel": {
      "type": "string",
      "default": ""
    },
    "turnaroundValue": {
      "type": "string",
      "default": ""
    },
    "turnaroundDescription": {
      "type": "string",
      "default": ""
    },
    "socialCards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "variations": [
    {
      "name": "supporting-graphs-steps",
      "title": "Supporting Graphs Steps",
      "description": "Step cards with turnaround time cards.",
      "attributes": {
        "variation": "variation-style-steps"
      },
      "scope": [
        "inserter"
      ]
    }
  ],
  "example": {
    "attributes": {
      "heading": "Lifetime Cancer Risk for Common Cancers (%)",
      "headingTag": "h2",
      "description": "This graph represents the highest risks associated with some genes in Hereditary Cancer."
    }
  }
}