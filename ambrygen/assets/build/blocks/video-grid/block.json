{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ambrygen/video-grid",
  "title": "Video Grid",
  "category": "ambrygen",
  "icon": "video-alt3",
  "description": "Video grid section with layout variations and multiple videos.",
  "textdomain": "ambrygen-web",
  "supports": {
    "html": false
  },
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "subheading": {
      "type": "string",
      "default": ""
    },
    "headingTag": {
      "type": "string",
      "enum": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ],
      "default": "h2"
    },
    "subDescription": {
      "type": "string",
      "default": ""
    },
    "variation": {
      "type": "string",
      "default": "variation-features",
      "enum": [
        "variation-features"
      ]
    },
    "topImageId": {
      "type": "number",
      "default": 0
    },
    "topImageUrl": {
      "type": "string",
      "default": ""
    },
    "topImageAlt": {
      "type": "string",
      "default": ""
    }
  },
  "providesContext": {
    "ambrygen/videoGridVariation": "variation"
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "example": {
    "attributes": {
      "description": "This is a sample preview content for this block in the inserter.",
      "subheading": "How to Videos",
      "headingTag": "h2",
      "subDescription": "Optional supporting text beneath the subheading.",
      "variation": "variation-features",
      "topImageId": 0,
      "topImageUrl": "",
      "topImageAlt": ""
    }
  }
}