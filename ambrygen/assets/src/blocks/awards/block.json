{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ambrygen/awards",
  "title": "Awards",
  "category": "ambrygen",
  "icon": "awards",
  "description": "Awards content block with description, CTAs, and award logo listing.",
  "textdomain": "ambrygen-web",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "headingTag": {
      "type": "string",
      "enum": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ],
      "default": "h2"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "imageId": {
            "type": "number"
          },
          "imageUrl": {
            "type": "string"
          },
          "imageAlt": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "example": {
    "attributes": {
      "blockId": "example-block-preview"
    }
  }
}
