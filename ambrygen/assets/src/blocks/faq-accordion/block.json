{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ambrygen/faq-accordion",
  "title": "FAQ Accordion",
  "textdomain": "ambrygen-web",
  "category": "ambrygen",
  "icon": "editor-help",
  "description": "Interactive FAQ accordion with image and expandable questions.",
  "supports": {
    "html": false,
    "anchor": true
  },
  "providesContext": {
    "ambrygen/faqAccordionVariant": "variant"
  },
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "headingTag": {
      "type": "string",
      "default": "h5",
      "enum": ["h1", "h2", "h3", "h4", "h5", "h6"]
    },
    "variant": {
      "type": "string",
      "default": "default",
      "enum": ["default", "without-image"]
    },
    "imageUrl": {
      "type": "string"
    },
    "imageId": {
      "type": "number",
      "default": 0
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "faqs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "subHeading": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "default": [
        {
          "id": "",
          "question": "",
          "subHeading": "",
          "answer": ""
        },
        {
          "id": "",
          "question": "",
          "subHeading": "",
          "answer": ""
        }
      ]
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "example": {
    "attributes": {
      "blockId": "faq-accordion-example"
    }
  }
}
