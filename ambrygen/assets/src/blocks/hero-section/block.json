{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ambrygen/hero-section",
  "title": "Hero Section",
  "category": "ambrygen",
  "icon": "cover-image",
  "description": "Hero section with slider, logo overlay, rounded background images, and dual call-to-action buttons.",
  "supports": {
    "html": false
  },
  "keywords": [
    "hero",
    "banner",
    "slider",
    "carousel"
  ],
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "backgroundImage":    { "type": "string",  "default": "" },
          "backgroundImageId":  { "type": "integer", "default": 0 },
          "backgroundImageAlt": { "type": "string",  "default": "" },
          "overlayImage1":      { "type": "string",  "default": "" },
          "overlayImage1Id":    { "type": "integer", "default": 0 },
          "overlayImage1Alt":   { "type": "string",  "default": "" },
          "overlayImage2":      { "type": "string",  "default": "" },
          "overlayImage2Id":    { "type": "integer", "default": 0 },
          "overlayImage2Alt":   { "type": "string",  "default": "" },
          "eyebrow":            { "type": "string",  "default": "" },
          "headingTag": {
            "type": "string",
            "enum": [ "h1", "h2", "h3", "h4", "h5", "h6" ],
            "default": "h2"
          },
          "heading":  { "type": "string", "default": "" },
          "content":  { "type": "string", "default": "" },
          "primarybutton": {
            "type": "object",
            "properties": {
              "url":     { "type": "string", "default": "" },
              "text":    { "type": "string", "default": "" },
              "target":  { "type": "string", "default": "" },
              "rel":     { "type": "string", "default": "" },
              "variant": { "type": "string", "default": "is-style-site-tertiary-btn" }
            }
          },
          "secondarybutton": {
            "type": "object",
            "properties": {
              "url":     { "type": "string", "default": "" },
              "text":    { "type": "string", "default": "" },
              "target":  { "type": "string", "default": "" },
              "rel":     { "type": "string", "default": "" },
              "variant": { "type": "string", "default": "dark" }
            }
          }
        }
      },
      "default": []
    },
    "showSliderNav": {
      "type": "boolean",
      "default": true
    },
    "showSliderDots": {
      "type": "boolean",
      "default": true
    },
    "autoplay": {
      "type": "boolean",
      "default": true
    },
    "showPauseButton": {
      "type": "boolean",
      "default": true
    },
    "autoplayDelay": {
      "type": "number",
      "default": 5000
    },
    "showSmallImage": {
      "type": "boolean",
      "default": false
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js",
  "textdomain": "ambrygen-web",
  "example": {
    "attributes": {
      "blockId": "hero-section-example"
    }
  }
}
