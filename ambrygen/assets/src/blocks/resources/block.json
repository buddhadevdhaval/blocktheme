{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ambrygen/resources",
	"title": "Resources",
	"category": "ambrygen",
	"icon": "index-card",
	"description": "A block to display resource cards and organization logos.",
	"textdomain": "ambrygen-web",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"attributes": {
		"blockId": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"subtitle": {
			"type": "string",
			"default": ""
		},
		"resourceCards": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"title": {
						"type": "string"
					},
					"pdfLinks": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"id": {
									"type": "string"
								},
								"label": {
									"type": "string"
								},
								"url": {
									"type": "string"
								}
							}
						}
					}
				}
			}
		},
		"orgTitle": {
			"type": "string",
			"default": ""
		},
		"collaboratorIds": {
			"type": "array",
			"default": [],
			"items": {
				"type": "integer"
			}
		},
		"resourcesCardTitle": {
			"type": "string",
			"default": ""
		},
		"headingLevel": {
			"type": "string",
			"default": "h2",
			"enum": [
				"h1",
				"h2",
				"h3",
				"h4",
				"h5",
				"h6"
			]
		},
		"customCollaborators": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"url": {
						"type": "string"
					},
					"target": {
						"type": "string"
					},
					"rel": {
						"type": "string"
					},
					"imageId": {
						"type": "integer"
					},
					"imageUrl": {
						"type": "string"
					},
					"imageAlt": {
						"type": "string"
					}
				}
			}
		},
		"enableCustomCollaborators": {
			"type": "boolean",
			"default": false
		}
	},
	"example": {
		"attributes": {
			"blockId": "resources-example"
		}
	}
}
