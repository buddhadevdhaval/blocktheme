{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ambrygen/split-content-section",
  "title": "Split Content Section",
  "category": "ambrygen",
  "icon": "align-pull-left",
  "description": "Mission statement banner with title, description, and background image.",
  "supports": {
    "html": false,
    "color": {
      "background": true,
      "text": true
    }
  },
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "titleTag": {
      "type": "string",
      "default": "h2",
      "enum": ["h1", "h2", "h3", "h4", "h5", "h6"]
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "backgroundImage": {
      "type": "string",
      "default": ""
    },
    "backgroundImageId": {
      "type": "number",
      "default": 0
    },
    "backgroundImageAlt": {
      "type": "string",
      "default": ""
    },
    "isHeaderVertical": {
      "type": "boolean",
      "default": false
    },
    "isMediumText": {
      "type": "boolean",
      "default": false
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "textdomain": "ambrygen-web",
  "example": {
    "attributes": {
      "blockId": "split-content-section-example"
    }
  }
}
