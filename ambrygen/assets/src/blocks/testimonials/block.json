{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ambrygen/testimonials",
  "title": "Testimonials",
  "category": "ambrygen",
  "icon": "format-quote",
  "supports": {
    "html": false,
    "color": {
      "background": true
    }
  },
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "headingTag": {
      "type": "string",
      "enum": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ],
      "default": "h2"
    },
    "mainImage": {
      "type": "string",
      "default": ""
    },
    "mainImageId": {
      "type": "number",
      "default": 0
    },
    "mainImageAlt": {
      "type": "string",
      "default": ""
    },
    "secondaryImage": {
      "type": "string",
      "default": ""
    },
    "secondaryImageId": {
      "type": "number",
      "default": 0
    },
    "secondaryImageAlt": {
      "type": "string",
      "default": ""
    },
    "overlayImage": {
      "type": "string",
      "default": ""
    },
    "overlayImageId": {
      "type": "number",
      "default": 0
    },
    "overlayImageAlt": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "textdomain": "ambrygen-web",
  "viewScript": "file:./view.js",
  "providesContext": {
    "ambrygen/mainImage": "mainImage",
    "ambrygen/mainImageId": "mainImageId",
    "ambrygen/mainImageAlt": "mainImageAlt"
  },
  "example": {
    "attributes": {
      "blockId": "testimonials-example"
    }
  }
}
