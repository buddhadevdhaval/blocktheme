{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ambrygen/three-column-image-grid-item",
  "title": "Image Grid Card",
  "category": "ambrygen",
  "parent": [
    "ambrygen/three-column-image-grid"
  ],
  "icon": "format-image",
  "description": "Single image card for three column grid.",
  "supports": {
    "html": false,
    "reusable": false
  },
  "usesContext": [
    "ambrygen/threeColumnVariation"
  ],
  "attributes": {
    "sectiontitle": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "imageUrl": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string"
    },
    "imageId": {
      "type": "number"
    },
    "videoTitle": {
      "type": "string",
      "default": ""
    },
    "videoContent": {
      "type": "string",
      "default": ""
    },
    "formTitle": {
      "type": "string",
      "default": ""
    },
    "formContent": {
      "type": "string",
      "default": ""
    },
    "cta": {
      "type": "object",
      "default": {
        "url": "",
        "text": "",
        "target": "",
        "rel": "",
        "variant": "dark",
        "isPopup": false,
        "popupType": "video",
        "videoType": "embed",
        "iframeUrl": "",
        "videoUrl": ""
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "fileId": {
            "type": "number"
          },
          "fileUrl": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "sizeType": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "textdomain": "ambrygen-web",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
