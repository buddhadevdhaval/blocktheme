{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ambrygen/timeline-item",
	"title": "Timeline Item",
	"category": "ambrygen",
	"icon": "marker",
	"parent": [ "ambrygen/timeline" ],
	"description": "Item block for the Timeline block.",
	"supports": {
		"html": false,
		"reusable": false
	},
	"usesContext": [ "ambrygen/timelineHeadingTag" ],
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"intro": {
			"type": "string",
			"default": ""
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imageId": {
			"type": "number",
			"default": 0
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"cta": {
			"type": "object",
			"default": {
				"text": "",
				"url": "",
				"target": "",
				"rel": ""
			}
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"textdomain": "ambrygen-web"
}
